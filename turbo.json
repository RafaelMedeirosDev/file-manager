{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint:ci": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "format": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "env": [
        "DATABASE_URL",
        "DATABASE_SCHEMA",
        "JWT_SECRET",
        "PORT",
        "NODE_ENV",
        "LOG_LEVELS",
        "MAX_UPLOAD_SIZE_BYTES",
        "R2_*"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "DATABASE_URL",
        "DATABASE_SCHEMA",
        "JWT_SECRET",
        "PORT",
        "NODE_ENV",
        "LOG_LEVELS",
        "MAX_UPLOAD_SIZE_BYTES",
        "R2_*"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "start:dev": {
      "persistent": true,
      "cache": false
    },
    "prisma:generate": {
      "outputs": [
        "node_modules/.prisma/**"
      ]
    },
    "prisma:migrate:dev": {
      "cache": false
    },
    "prisma:migrate:deploy": {
      "cache": false
    }
  }
}
