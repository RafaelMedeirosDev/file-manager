
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ROLE {
  ADMIN
  USER
}

enum ExamCategory {
  THROMBOPHILIA
  MICROBIOLOGY
  ENDOCRINE_METABOLIC
  IMMUNOLOGY
  OBSTETRIC_MARKERS
  IMAGING
  BIOCHEMISTRY
  HEMATOLOGY
}

// ── Sobre indices ────────────────────────────────────────────────────────────
// Os @@index abaixo cobrem as 5 chaves estrangeiras. O que ficou de fora, e por
// que, para nao se perder a analise:
//
// * Compostos com deleted_at (`@@index([deletedAt, userId, name])` e afins).
//   `deleted_at IS NULL` esta em toda listagem, mas cada metodo tem 4 a 6
//   formas de `where` conforme papel e filtro; cobrir todas exigiria ~12
//   indices. Com o volume atual o planner escolhe seq scan e nenhum seria
//   usado. Quando entrarem, devem ser compostos (expressaveis aqui) e nao
//   parciais, que o Prisma nao representa e que gerariam drift a cada
//   `migrate dev`.
//
// * Busca textual. `contains` + `mode: insensitive` gera `ILIKE '%termo%'`.
//   B-tree nao atende: sem prefixo constante nao ha ponto de entrada na
//   arvore. A resposta correta seria GIN de trigramas (`pg_trgm`), que exige
//   CREATE EXTENSION e um preview flag do Prisma -- desproporcional para o
//   volume deste projeto.
//
// * folders.is_default e users.role. Nunca sao predicado de WHERE em producao:
//   is_default e lido de uma linha ja buscada por PK, e role filtra uma
//   relacao to-one com dois valores distintos, seletividade que nao justifica
//   indice.
//
// * Compostos com organization_id. Desde a introducao de multi-tenancy,
//   organization_id esta em todo WHERE de negocio -- o que muda o argumento do
//   primeiro item, porque agora existe uma coluna comum a todas as formas de
//   where. Ainda assim nao paga no volume atual. Quando pagar, os candidatos
//   sao @@index([organizationId, userId]) em folders e files, nessa ordem: a
//   org e sempre igualdade e vem primeiro, o dono e igualdade so quando o
//   papel e USER.

// As organizacoes sao a raiz do isolamento de dados. Um usuario e uma
// identidade global -- `users.email` segue unique sem recorte de organizacao,
// e e justamente isso que permite a mesma pessoa pertencer a duas delas.
// Quem liga os dois lados e Membership, que tambem carrega o papel: alguem
// pode ser ADMIN numa organizacao e USER em outra.
//
// Sobre `deletedAt` nestes dois models: existe por consistencia com os outros
// cinco, mas e conferido em exatamente DOIS lugares -- JwtStrategy.validate e
// o endpoint de selecao de organizacao. Nenhuma consulta de negocio precisa
// checar: elas recortam por organizationId, e um token so existe se a
// associacao estava ativa no momento em que foi emitido e continua ativa a
// cada requisicao. Adicionar a checagem nas consultas de negocio seria
// redundancia sem ganho.
model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(50)
  slug      String    @unique @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  memberships Membership[]

  @@map("organizations")
}

model Membership {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid @map("user_id")
  organizationId String    @db.Uuid @map("organization_id")
  role           ROLE
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  // A unique nao tem recorte de deleted_at, mesmo critério de users.email e
  // exams.code: uma associacao soft-deletada continua ocupando o par. Quem
  // reconstroi a organizacao demo apaga fisicamente, e o caminho de negocio
  // para religar alguem e limpar o deleted_at, nao inserir de novo.
  @@unique([userId, organizationId])
  // user_id vem de graca no indice unico acima (e a primeira coluna dele).
  // organization_id precisa do proprio: e por ele que se lista quem pertence
  // a uma organizacao.
  @@index([organizationId])
  @@map("memberships")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(50)
  email     String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  role      ROLE
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  folders      Folder[]
  files        File[]
  examRequests ExamRequest[]
  memberships  Membership[]

  @@map("users")
}

model Folder {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(50)
  userId    String    @db.Uuid @map("user_id")
  folderId  String?   @db.Uuid @map("folder_id")
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user     User     @relation(fields: [userId], references: [id])
  parent   Folder?  @relation("FolderToFolder", fields: [folderId], references: [id])
  children Folder[] @relation("FolderToFolder")
  files    File[]

  // O PostgreSQL nao cria indice para chave estrangeira automaticamente.
  // folder_id e o mais usado do schema: `include: { children: true }` aparece
  // em findById, findAll e listFoldersActive, e cada um vira um
  // `WHERE folder_id = $1`. user_id serve o escopo por dono das listagens.
  @@index([userId])
  @@index([folderId])
  @@map("folders")
}

model File {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  userId    String    @db.Uuid @map("user_id")
  folderId  String?   @db.Uuid @map("folder_id")
  extension String    @db.VarChar(20)
  // Chave do objeto no R2 (`<uuid>.<ext>`). E a fonte da verdade para ler o
  // binario: o download usa GetObjectCommand com esta chave, nunca uma URL.
  key       String    @db.VarChar(255)
  // Legado do periodo em que o bucket era publico. Nao e mais gravada, exposta
  // pela API nem usada para buscar o arquivo: quem resolve o binario e `key`.
  // Opcional aqui para que os registros antigos preservem o valor enquanto a
  // coluna aguarda o DROP, previsto para a proxima migration.
  url       String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user   User    @relation(fields: [userId], references: [id])
  folder Folder? @relation(fields: [folderId], references: [id])

  @@index([userId])
  @@index([folderId])
  @@map("files")
}

model Exam {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(255)
  code      String       @unique @db.VarChar(50)
  category  ExamCategory
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  examRequests ExamRequest[]

  @@map("exams")
}

model ExamRequest {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid @map("user_id")
  indication String    @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  user  User   @relation(fields: [userId], references: [id])
  exams Exam[]

  @@index([userId])
  @@map("exam_requests")
}
