# Database
# Casa com o docker-compose.yml da raiz (docker compose up -d).
DATABASE_URL=postgresql://file_manager:file_manager@localhost:5432/file_manager?schema=public
DATABASE_SCHEMA=public

# JWT
JWT_SECRET=troque-este-valor-em-producao

# App
PORT=3000
NODE_ENV=development
LOG_LEVELS=log,error,warn
MAX_UPLOAD_SIZE_BYTES=10485760

# Origens aceitas pelo CORS, separadas por virgula. Opcional: sem ela vale o
# default http://localhost:5173, que atende o front em desenvolvimento.
# Em producao, liste aqui o dominio do front — do contrario a API rejeita as
# chamadas dele.
CORS_ORIGINS=http://localhost:5173

# Cloudflare R2
# Os placeholders abaixo permitem a API subir e todo o resto funcionar
# (login, usuarios, pastas, exames). Apenas upload e download de arquivos
# exigem um bucket real — substitua por credenciais validas para usa-los.
R2_ACCOUNT_ID=placeholder
R2_ACCESS_KEY_ID=placeholder
R2_SECRET_ACCESS_KEY=placeholder
R2_BUCKET_NAME=placeholder
R2_ENDPOINT=
R2_PUBLIC_URL=https://example.invalid
